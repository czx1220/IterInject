# Export these variables in your shell before a model run.
# IterInject does not load .env files, and does not save the credential values.
# The optional scripts/run_deepseek_smoke.py launcher explicitly loads
# DEEPSEEK_API_KEY from local .env.deepseek without executing that file.
# Set role-specific model/base_url/temperature/max_output_tokens in explicit JSON config.
ITERINJECT_VICTIM_API_KEY=
ITERINJECT_OPTIMIZER_API_KEY=
# DS generate_on_miss uses its own explicitly configured simulator role.
ITERINJECT_SIMULATION_API_KEY=
