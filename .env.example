# Target model API (victim LLM)
OPENAI_API_KEY=replace-with-your-target-api-key
OPENAI_BASE_URL=https://api.example.com/v1

# Payload optimizer API
# AgentDojo experiments in the paper use Qwen3-8B with temperature 0.7.
MUTATION_MODEL=Qwen3-8B
MUTATION_API_KEY=replace-with-your-mutation-api-key
MUTATION_BASE_URL=http://127.0.0.1:8001/v1
MUTATION_TEMPERATURE=0.7

# Paper setting: disable for GLM/DeepSeek/Qwen; retain MiniMax server default.
# Set true/false to override this model-aware behavior.
DISABLE_THINKING=auto
